# true muestra la barra central y la vista previa de la derecha.
# false las oculta. Hay que reiniciar el servidor de Vite para que tome el cambio.
VITE_PREVIEW_ENABLED=false

# URL del generador Word. Si se omite, el formulario usa http://127.0.0.1:8100.
# En el ambiente de pruebas se define al publicar, no en este archivo.
# VITE_API_URL=https://proforma-pruebas.onrender.com

# true: el botón dice Generar Proforma y descarga el Word en el navegador,
# sin llamar al generador ni al correo.
# false: el botón dice Enviar Proforma y envía el correo, como ahora.
# Hay que reiniciar Vite para que tome el cambio.
VITE_LOCAL_WORD=true
