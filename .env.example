# true muestra la barra central y la vista previa de la derecha.
# false las oculta. Hay que reiniciar el servidor de Vite para que tome el cambio.
VITE_PREVIEW_ENABLED=false

# URL del generador Word, el que rellena Template.docx.
# Si se omite, el formulario usa http://127.0.0.1:8100.
# Hay que reiniciar Vite para que tome el cambio.
# VITE_API_URL=https://proforma-pruebas.onrender.com

# true: el botón dice Generar Proforma, pide el Word con la plantilla al generador y lo descarga. No envía correo.
# false: el botón dice Enviar Proforma y envía el correo.
# Hay que reiniciar Vite para que tome el cambio.
VITE_LOCAL_WORD=true
